# VCP Scanner backend environment template.
# Copy to backend/.env and fill in real values.

# --- LLM (any OpenAI-compatible /v1 endpoint; DeepSeek, OpenAI, Ollama, LiteLLM...) ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# --- Telegram notification dispatcher (@devops-ops) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Server ---
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
MIN_TELEGRAM_ALERT_SCORE=85
DB_PATH=data/bars.db
# Docker: nginx serves on :80, add its origin to CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]